# Chuỗi kết nối Postgres (bắt buộc). Railway tự cấp khi thêm PostgreSQL.
DATABASE_URL=postgres://postgres:pw@localhost:5432/postgres

# Khoá ký JWT (bắt buộc), chuỗi ngẫu nhiên ít nhất 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cổng server (Railway tự đặt PORT)
PORT=3000

# Origin frontend được phép gọi API, ngăn cách bằng dấu phẩy.
# Bản deploy: https://congminh204.github.io  (không có /storyLoop)
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# false = tắt đăng ký tài khoản mới (cả tạo mới qua Google)
ALLOW_SIGNUP=true

# OAuth Client ID của Google (Google Cloud Console). Để trống = tắt đăng nhập Google.
GOOGLE_CLIENT_ID=
