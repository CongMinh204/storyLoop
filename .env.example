# Sao chép thành .env.local để chạy local (npm run dev). Khi build trên GitHub Actions, các biến này
# lấy từ Settings > Secrets and variables > Actions > Variables.

# Địa chỉ backend (thư mục server/ chạy trên Railway). Không có thì app chỉ chạy chế độ khách.
VITE_API_URL=

# OAuth Client ID của Google. Không có thì ẩn nút "Đăng nhập bằng Google".
VITE_GOOGLE_CLIENT_ID=

# Measurement ID của Google Analytics 4. Để trống thì dùng mã G-T3735NH85E đã ghi sẵn trong code.
VITE_GA_ID=
